<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ================================================================
         Wet ash, cold steel, oxidised rust.
         ================================================================ -->
    <SolidColorBrush x:Key="Bg"        Color="#FF08090A" />
    <SolidColorBrush x:Key="Surface"   Color="#FF121315" />
    <SolidColorBrush x:Key="SurfaceHi" Color="#FF191A1D" />
    <SolidColorBrush x:Key="Border"    Color="#FF26241F" />
    <SolidColorBrush x:Key="BorderHi"  Color="#FF3A342C" />
    <SolidColorBrush x:Key="Fg"        Color="#FFCFC9C1" />
    <SolidColorBrush x:Key="Fg2"       Color="#FF7C766D" />
    <SolidColorBrush x:Key="Fg3"       Color="#FF6E6A62" />
    <SolidColorBrush x:Key="Accent"    Color="#FF8C3B22" />
    <SolidColorBrush x:Key="AccentHi"  Color="#FFB4502C" />
    <SolidColorBrush x:Key="Ash"       Color="#FFA8B0A6" />
    <SolidColorBrush x:Key="Danger"    Color="#FFC59079" />

    <!-- fog over the window, darkness pooling at the edges -->
    <LinearGradientBrush x:Key="FogBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FF101214" Offset="0" />
        <GradientStop Color="#FF0A0B0C" Offset="0.45" />
        <GradientStop Color="#FF060607" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="VignetteBrush" GradientOrigin="0.5,0.15" Center="0.5,0.2"
                         RadiusX="0.95" RadiusY="0.9">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.55" />
        <GradientStop Color="#5E000000" Offset="1" />
    </RadialGradientBrush>

    <!-- ============================== text ============================== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFDDD6CB" />
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Fg2}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Fg3}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,20,0,9" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Ash}" />
    </Style>

    <Style x:Key="Serif.Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="Foreground" Value="#FFD9D2C7" />
    </Style>

    <!-- ============================= tooltip ============================ -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#FF191A1D" BorderBrush="{StaticResource BorderHi}" BorderThickness="1"
                            Padding="11,9" MaxWidth="400">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= surfaces =========================== -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- each feature sits on its own card, as it did before -->
    <Style x:Key="Row" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderHi}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== buttons =========================== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="#FF1B1C1F" />
        <Setter Property="BorderBrush" Value="#FF322C25" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF25262A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF141517" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="#FFA8482A" />
        <Setter Property="Foreground" Value="#FFF2E9E2" />
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Fg2}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <!-- =============================== toggle =========================== -->
    <Style x:Key="Toggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Width="36" Height="19" CornerRadius="10"
                            Background="#FF1B1C1F" BorderBrush="#FF3A342C" BorderThickness="1">
                        <Border x:Name="knob" Width="13" Height="13" CornerRadius="7" Background="#FF6E6A62"
                                HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentHi}" />
                            <Setter TargetName="knob" Property="Background" Value="#FFF2E9E2" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== checkbox ========================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="14" Height="14" CornerRadius="2"
                                Background="#FF0D0E0F" BorderBrush="#FF3A342C" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="tick" Stretch="Uniform" Margin="2.5" Opacity="0"
                                  Data="M 0 5 L 3.5 8.5 L 10 1" Stroke="#FFE4DBCE" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Opacity" Value="1" />
                            <Setter TargetName="box" Property="Background" Value="#FF2A1109" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= scrollbar ========================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#FF35312B" CornerRadius="4" Margin="2,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= combo box ==========================
         WPF keeps a light popup whatever brushes you set, so it is templated.
         ================================================================== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="#FF1B1C1F" BorderBrush="#FF322C25"
                            BorderThickness="1" CornerRadius="2">
                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,11,0" Data="M 0 0 L 4.5 5 L 9 0 Z" Fill="{StaticResource Fg2}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderThickness="2,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF232428" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1E2023" />
                            <Setter Property="Foreground" Value="#FFEDE6DC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,30,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="#FF141517" BorderBrush="#FF34302A" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.7" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== textbox =========================== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="#FF0D0E0F" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    </Style>

</ResourceDictionary>
